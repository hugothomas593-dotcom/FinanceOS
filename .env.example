# Supabase — browser-safe project URL and publishable key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Backward compatibility only. Prefer NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel AI Gateway. Vercel deployments use OIDC automatically.
# For local development outside Vercel, use a private Gateway API key.
AI_GATEWAY_MODEL=anthropic/claude-sonnet-4.6
AI_GATEWAY_API_KEY=

# Optional Stripe (server-side only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Server-side only. Never expose this key in NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=

# Powens Open Banking (all values server-side; obtain them from your Powens account)
POWENS_DOMAIN=
POWENS_CLIENT_ID=
POWENS_CLIENT_SECRET=
# Generate 32 random bytes and base64-encode them; keep this key backed up securely.
AVENOR_CONNECTION_ENCRYPTION_KEY=

# Weekly CFO report delivery (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Vercel sends this as Authorization: Bearer <CRON_SECRET> to scheduled routes.
CRON_SECRET=
