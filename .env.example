# Supabase — browser-safe project URL and publishable key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Backward compatibility only. Prefer NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional AI explanation layer (server-side only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional Stripe billing (server-side only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Server-side only. Never expose this key in NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=
